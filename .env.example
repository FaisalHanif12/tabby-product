# ── AWS (provisioned via Terraform; credentials come from Vercel↔AWS OIDC) ──
# Region the DynamoDB table and S3 bucket live in.
AWS_REGION=us-east-1
# ARN of the IAM role Vercel assumes via OIDC. NO static AWS keys are used.
AWS_ROLE_ARN=arn:aws:iam::000000000000:role/tabby-vercel-oidc
# Single-table DynamoDB table name.
TABLE_NAME=tabby
# S3 bucket for receipt images + generated settlement receipts.
S3_BUCKET=tabby-receipts

# ── OCR proxy (server-only) ──
# OpenRouter API key used by /api/receipts/parse. Never exposed to the client.
OPENROUTER_API_KEY=sk-or-...
# Multimodal model used to parse receipts (defaults to google/gemini-2.5-flash).
OCR_MODEL=google/gemini-2.5-flash

# ── Optional auth (Clerk) ──
# OPTIONAL. Leave all CLERK_* unset to run Tabby fully anonymous — the app still
# builds and renders without these (no sign-in UI appears). Set them to enable
# sign-in, saved history, and profiles. Keys are from the Clerk dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Use Clerk's modal sign-in (no hosted pages needed). These keep deep links sane.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/?sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/?sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
