# ── AWS (provisioned via Terraform; credentials come from Vercel↔AWS OIDC) ──
# Region the DynamoDB table and S3 bucket live in.
AWS_REGION=us-east-1
# ARN of the IAM role Vercel assumes via OIDC. NO static AWS keys are used.
AWS_ROLE_ARN=arn:aws:iam::000000000000:role/tabby-vercel-oidc
# Single-table DynamoDB table name.
TABLE_NAME=tabby
# S3 bucket for receipt images + generated settlement receipts.
S3_BUCKET=tabby-receipts

# ── OCR proxy (server-only) ──
# OpenRouter API key used by /api/receipts/parse. Never exposed to the client.
OPENROUTER_API_KEY=sk-or-...
# Multimodal model used to parse receipts (defaults to google/gemini-3.5-flash).
OCR_MODEL=google/gemini-3.5-flash
